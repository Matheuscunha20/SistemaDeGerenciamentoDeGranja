@model SistemaGranja.Domain.RegistroSaude

@{
    ViewData["Title"] = "Ocorrência de saúde";
}

<div class="page-header">
    <h1>Ocorrência de saúde</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-agro">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar para a lista</a>
    </div>
</div>

<div class="card shadow-sm" style="max-width: 820px;">
    <div class="card-body">
        <partial name="_Resumo" model="Model" />
    </div>
</div>
