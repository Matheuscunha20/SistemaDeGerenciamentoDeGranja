@model IEnumerable<SistemaGranja.Domain.Animal>

@{
    ViewData["Title"] = "Animais";
    var filtroAtivo = ViewData["FiltroAtivo"] is true;
}
@functions {
    string CorStatus(string status) => status switch
    {
        "Saudável" => "bg-success",
        "Em observação" => "bg-info text-dark",
        "Em tratamento" => "bg-warning text-dark",
        "Em quarentena" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="page-header">
    <h1>Animais</h1>
    <a asp-action="Create" class="btn btn-agro">+ Novo animal</a>
</div>

<form asp-action="Index" method="get" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="busca" class="form-label small text-muted mb-1">Buscar</label>
                <input type="search" id="busca" name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Brinco/tag ou nome" />
            </div>
            <div class="col-md-2">
                <label for="especieId" class="form-label small text-muted mb-1">Espécie</label>
                <select id="especieId" name="especieId" class="form-select" asp-items="ViewBag.FiltroEspecies">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="galpaoId" class="form-label small text-muted mb-1">Galpão</label>
                <select id="galpaoId" name="galpaoId" class="form-select" asp-items="ViewBag.FiltroGalpoes">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="statusSaude" class="form-label small text-muted mb-1">Saúde</label>
                <select id="statusSaude" name="statusSaude" class="form-select" asp-items="ViewBag.FiltroStatus">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-agro flex-grow-1">Filtrar</button>
                @if (filtroAtivo)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpar filtros">Limpar</a>
                }
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            @if (filtroAtivo)
            {
                <p class="mb-3">Nenhum animal encontrado com esses filtros.</p>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpar filtros</a>
            }
            else
            {
                <p class="mb-3">Nenhum animal cadastrado ainda.</p>
                <a asp-action="Create" class="btn btn-agro">Cadastrar o primeiro</a>
            }
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.TagIdentificacao)</th>
                        <th>@Html.DisplayNameFor(model => model.Nome)</th>
                        <th>Espécie</th>
                        <th>@Html.DisplayNameFor(model => model.Raca)</th>
                        <th>@Html.DisplayNameFor(model => model.Sexo)</th>
                        <th>@Html.DisplayNameFor(model => model.IdadeDescricao)</th>
                        <th>@Html.DisplayNameFor(model => model.PesoAtual)</th>
                        <th>@Html.DisplayNameFor(model => model.StatusSaude)</th>
                        <th>@Html.DisplayNameFor(model => model.Galpao)</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.TagIdentificacao</td>
                        <td>@(string.IsNullOrEmpty(item.Nome) ? "—" : item.Nome)</td>
                        <td>@(item.Raca?.Especie?.Nome ?? "—")</td>
                        <td>@(item.Raca?.Nome ?? "—")</td>
                        <td>@item.Sexo</td>
                        <td>@item.IdadeDescricao</td>
                        <td>@Html.DisplayFor(m => item.PesoAtual)</td>
                        <td><span class="badge @CorStatus(item.StatusSaude)">@item.StatusSaude</span></td>
                        <td>@(item.Galpao?.NomeOuNumero ?? "—")</td>
                        <td class="text-end acoes">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (User.PodeGerenciar()) { <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">@Model.Count() animal(is) @(filtroAtivo ? "encontrado(s)" : "cadastrado(s)")</p>
}
