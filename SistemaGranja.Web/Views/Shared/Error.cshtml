@model ErrorViewModel
@{
    ViewData["Title"] = "Algo deu errado";
}

<div class="text-center py-5">
    <h1 class="h3 mb-2">Algo deu errado</h1>
    <p class="text-muted mb-1">Não foi possível concluir o que você pediu. Tente de novo em instantes.</p>
    <p class="text-muted">Se o problema continuar, avise o suporte informando o código abaixo.</p>
    @if (Model.ShowRequestId)
    {
        <p><code>@Model.RequestId</code></p>
    }
    <a href="~/" class="btn btn-agro">Voltar ao início</a>
</div>
