@model IEnumerable<SistemaGranja.Domain.TipoAlimento>

@{
    ViewData["Title"] = "Tipos de Alimento";
}

<div class="page-header">
    <h1>Tipos de Alimento</h1>
    <a asp-action="Create" class="btn btn-agro">+ Novo tipo de alimento</a>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">Nenhum tipo de alimento cadastrado ainda.</p>
            <a asp-action="Create" class="btn btn-agro">Cadastrar o primeiro</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table tabela-cartoes table-hover mb-0">
                <thead>
                    <tr>
                    <th>@Html.DisplayNameFor(model => model.Nome)</th>
                    <th>@Html.DisplayNameFor(model => model.UnidadeMedidaPadrao)</th>
                    <th>@Html.DisplayNameFor(model => model.Fabricante)</th>
                    <th>@Html.DisplayNameFor(model => model.CodigoInterno)</th>
                    <th>@Html.DisplayNameFor(model => model.EstoqueMinimo)</th>
                    <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.UnidadeMedidaPadrao</td>
                        <td>@(string.IsNullOrEmpty(item.Fabricante) ? "—" : item.Fabricante)</td>
                        <td>@(string.IsNullOrEmpty(item.CodigoInterno) ? "—" : item.CodigoInterno)</td>
                        <td>@(item.EstoqueMinimo.HasValue ? $"{item.EstoqueMinimo.Value:N2} {item.UnidadeMedidaPadrao}" : "—")</td>
                        <td class="text-end acoes">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">Total: @Model.Count() registro(s)</p>
}
