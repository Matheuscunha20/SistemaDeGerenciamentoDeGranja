@model IEnumerable<SistemaGranja.Domain.RegistroVacinacao>

@{
    ViewData["Title"] = "Histórico de vacinação";
    var filtroAtivo = ViewData["FiltroAtivo"] is true;
}

<partial name="_Abas" />

<form asp-action="Historico" method="get" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="busca" class="form-label small text-muted mb-1">Animal</label>
                <input type="search" id="busca" name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Brinco/tag ou nome" />
            </div>
            <div class="col-md-3">
                <label for="tipoVacinaId" class="form-label small text-muted mb-1">Vacina</label>
                <select id="tipoVacinaId" name="tipoVacinaId" class="form-select" asp-items="ViewBag.FiltroVacinas">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="de" class="form-label small text-muted mb-1">De</label>
                <input type="date" id="de" name="de" value="@ViewData["De"]" class="form-control" />
            </div>
            <div class="col-md-2">
                <label for="ate" class="form-label small text-muted mb-1">Até</label>
                <input type="date" id="ate" name="ate" value="@ViewData["Ate"]" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-agro flex-grow-1">Filtrar</button>
                @if (filtroAtivo)
                {
                    <a asp-action="Historico" class="btn btn-outline-secondary">Limpar</a>
                }
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">@(filtroAtivo ? "Nenhuma vacinação encontrada com esses filtros." : "Nenhuma vacinação registrada ainda.")</p>
            <a asp-action="Create" class="btn btn-agro">Registrar vacinação</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Animal</th>
                        <th>Espécie</th>
                        <th>Vacina</th>
                        <th>Dose</th>
                        <th>Lote do frasco</th>
                        <th>Aplicado por</th>
                        <th>Próxima dose</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.DataVacinacao.ToString("dd/MM/yyyy")</td>
                        <td><a asp-controller="Animais" asp-action="Details" asp-route-id="@item.AnimalId">@item.Animal?.TagIdentificacao</a></td>
                        <td>@(item.Animal?.Raca?.Especie?.Nome ?? "—")</td>
                        <td>@item.TipoVacina?.NomeVacina</td>
                        <td>@(string.IsNullOrEmpty(item.DoseAplicada) ? "—" : item.DoseAplicada)</td>
                        <td>@(string.IsNullOrEmpty(item.LoteProdutoVacina) ? "—" : item.LoteProdutoVacina)</td>
                        <td>@(item.Funcionario?.NomeCompleto ?? "—")</td>
                        <td>@(item.DataProximaDoseRecomendada?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="text-end acoes">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">@Model.Count() aplicação(ões)</p>
}
