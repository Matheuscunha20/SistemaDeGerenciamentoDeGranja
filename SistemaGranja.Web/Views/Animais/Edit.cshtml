@model SistemaGranja.Domain.Animal

@{
    ViewData["Title"] = "Editar animal";
}

<div class="page-header">
    <h1>Editar animal</h1>
</div>

<div class="card shadow-sm form-card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-agro">Salvar alterações</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/animais-form.js" asp-append-version="true"></script>
}
