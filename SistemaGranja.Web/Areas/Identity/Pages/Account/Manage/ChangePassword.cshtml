@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Trocar senha";
    ViewData["PaginaAtiva"] = "Senha";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h6 mb-3">Trocar senha</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.SenhaAtual" class="form-label"></label>
                <input asp-for="Input.SenhaAtual" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.SenhaAtual" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.NovaSenha" class="form-label"></label>
                <input asp-for="Input.NovaSenha" class="form-control" autocomplete="new-password" />
                <div class="form-text">Pelo menos 6 caracteres, com letra maiúscula, letra minúscula, número e símbolo (ex.: Rebanho@2026).</div>
                <span asp-validation-for="Input.NovaSenha" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ConfirmarSenha" class="form-label"></label>
                <input asp-for="Input.ConfirmarSenha" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmarSenha" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-agro">Salvar nova senha</button>
            <a asp-page="/Account/ForgotPassword" class="btn btn-link">Esqueci a senha atual</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
