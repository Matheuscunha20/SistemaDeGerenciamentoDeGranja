@model FazendaController.DadosFazenda

@{
    ViewData["Title"] = "Dados da fazenda";
}

<div class="page-header">
    <h1>Dados da fazenda</h1>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Ex.: Fazenda Boa Vista" autofocus />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <p class="text-muted small">Cliente AgroArca desde @Model.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy").</p>
                    <button type="submit" class="btn btn-agro">Salvar</button>
                    <a asp-controller="Equipe" asp-action="Index" class="btn btn-outline-secondary">Gerenciar equipe</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
