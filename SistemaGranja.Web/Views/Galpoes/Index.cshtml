@model IEnumerable<SistemaGranja.Domain.Galpao>

@{
    ViewData["Title"] = "Galpões";
    var ocupacao = ViewData["Ocupacao"] as Dictionary<int, int> ?? new Dictionary<int, int>();
    var totalOcupado = Model.Sum(g => ocupacao.GetValueOrDefault(g.Id));
    var totalCapacidade = Model.Sum(g => g.CapacidadeMaxima);
}
@functions {
    // Verde até 70%, amarelo até 90%, vermelho acima disso
    string CorOcupacao(int percentual) => percentual >= 90 ? "bg-danger" : percentual >= 70 ? "bg-warning" : "bg-success";
}

<div class="page-header">
    <h1>Galpões</h1>
    <a asp-action="Create" class="btn btn-agro">+ Novo galpão</a>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">Nenhum galpão cadastrado ainda.</p>
            <a asp-action="Create" class="btn btn-agro">Cadastrar o primeiro</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.NomeOuNumero)</th>
                        <th>@Html.DisplayNameFor(model => model.TipoInstalacao)</th>
                        <th>@Html.DisplayNameFor(model => model.LocalizacaoDescricao)</th>
                        <th style="min-width: 220px;">Ocupação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var ocupados = ocupacao.GetValueOrDefault(item.Id);
                    var percentual = item.CapacidadeMaxima > 0 ? (int)Math.Round(ocupados * 100.0 / item.CapacidadeMaxima) : 0;
                    <tr>
                        <td class="fw-semibold">@item.NomeOuNumero</td>
                        <td>@item.TipoInstalacao</td>
                        <td>@(string.IsNullOrEmpty(item.LocalizacaoDescricao) ? "—" : item.LocalizacaoDescricao)</td>
                        <td>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@ocupados de @item.CapacidadeMaxima</span>
                                <span class="text-muted">@percentual%</span>
                            </div>
                            <div class="progress" style="height: 8px;" role="progressbar" aria-valuenow="@percentual" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @CorOcupacao(percentual)" style="width: @(Math.Min(percentual, 100))%"></div>
                            </div>
                        </td>
                        <td class="text-end acoes">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">
        @Model.Count() galpão(ões) · @totalOcupado animal(is) alojado(s) · capacidade total de @totalCapacidade
    </p>
}
