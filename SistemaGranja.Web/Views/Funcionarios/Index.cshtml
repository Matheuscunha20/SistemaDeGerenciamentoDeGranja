@model IEnumerable<SistemaGranja.Domain.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
    var situacao = ViewData["Situacao"] as string ?? "ativos";
}

<div class="page-header">
    <h1>Funcionários</h1>
    <a asp-action="Create" class="btn btn-agro">+ Novo funcionário</a>
</div>

<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
    <ul class="nav nav-pills">
        <li class="nav-item">
            <a class="nav-link @(situacao == "ativos" ? "active" : "")" asp-action="Index" asp-route-situacao="ativos" asp-route-busca="@(ViewData["Busca"] as string)">Ativos</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(situacao == "desligados" ? "active" : "")" asp-action="Index" asp-route-situacao="desligados" asp-route-busca="@(ViewData["Busca"] as string)">Desligados</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(situacao == "todos" ? "active" : "")" asp-action="Index" asp-route-situacao="todos" asp-route-busca="@(ViewData["Busca"] as string)">Todos</a>
        </li>
    </ul>
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="hidden" name="situacao" value="@situacao" />
        <input type="search" name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Nome, cargo ou CPF" />
        <button type="submit" class="btn btn-agro">Buscar</button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">Nenhum funcionário encontrado.</p>
            <a asp-action="Create" class="btn btn-agro">Cadastrar funcionário</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.NomeCompleto)</th>
                        <th>@Html.DisplayNameFor(model => model.Cargo)</th>
                        <th>@Html.DisplayNameFor(model => model.CpfFormatado)</th>
                        <th>@Html.DisplayNameFor(model => model.Telefone)</th>
                        <th>@Html.DisplayNameFor(model => model.DataAdmissao)</th>
                        <th>@Html.DisplayNameFor(model => model.Ativo)</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.NomeCompleto</td>
                        <td>@item.Cargo</td>
                        <td>@item.CpfFormatado</td>
                        <td>@(string.IsNullOrEmpty(item.Telefone) ? "—" : item.Telefone)</td>
                        <td>@Html.DisplayFor(m => item.DataAdmissao)</td>
                        <td>
                            @if (item.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Desligado</span>
                            }
                        </td>
                        <td class="text-end acoes">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">Total: @Model.Count() funcionário(s)</p>
}
