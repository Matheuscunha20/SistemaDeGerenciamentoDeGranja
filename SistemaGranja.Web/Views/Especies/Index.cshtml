@model IEnumerable<SistemaGranja.Domain.Especie>

@{
    ViewData["Title"] = "Espécies";
}

<div class="page-header">
    <h1>Espécies</h1>
    <a asp-action="Create" class="btn btn-agro">+ Nova espécie</a>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">Nenhuma espécie cadastrada ainda.</p>
            <a asp-action="Create" class="btn btn-agro">Cadastrar a primeira</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Espécie</th>
                        <th>Raças cadastradas</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nome</td>
                        <td>@item.Racas.Count</td>
                        <td class="text-end acoes">
                            <a asp-controller="Racas" asp-action="Index" asp-route-especieId="@item.Id" class="btn btn-sm btn-outline-secondary">Ver raças</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">Total: @Model.Count() espécie(s)</p>
}
