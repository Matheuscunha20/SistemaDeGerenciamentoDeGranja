@page
@model ConfirmEmailModel

@{
    ViewData["Title"] = "Confirmação de e-mail";
}

<div class="text-center py-5">
    @if (Model.Confirmado)
    {
        <h1 class="h3 mb-2">E-mail confirmado!</h1>
        <p class="text-muted">Obrigado. Seu e-mail foi confirmado com sucesso.</p>
    }
    else
    {
        <h1 class="h3 mb-2">Não foi possível confirmar</h1>
        <p class="text-muted">O link é inválido ou já expirou. Você pode pedir um novo em Minha conta, ou na tela de login.</p>
    }
    <a href="~/" class="btn btn-agro">Ir para o início</a>
</div>
