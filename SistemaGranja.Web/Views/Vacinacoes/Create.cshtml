@model SistemaGranja.Domain.RegistroVacinacao

@{
    ViewData["Title"] = "Registrar vacinação";
}

<div class="page-header">
    <h1>Registrar vacinação</h1>
</div>

<div class="card shadow-sm" style="max-width: 820px;">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" name="voltarParaAnimal" value="@ViewData["VoltarParaAnimal"]" />
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-agro">Registrar</button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/vacinacao-form.js" asp-append-version="true"></script>
}
