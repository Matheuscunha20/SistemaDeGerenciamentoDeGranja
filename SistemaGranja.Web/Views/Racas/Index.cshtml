@model IEnumerable<SistemaGranja.Domain.Raca>

@{
    ViewData["Title"] = "Raças";
    var especieFiltrada = ViewData["EspecieFiltrada"] as int?;
}

<div class="page-header">
    <h1>Raças</h1>
    <a asp-action="Create" asp-route-especieId="@especieFiltrada" class="btn btn-agro">+ Nova raça</a>
</div>

<form asp-action="Index" method="get" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="especieId" class="form-label small text-muted mb-1">Espécie</label>
                <select id="especieId" name="especieId" class="form-select" asp-items="ViewBag.FiltroEspecies" onchange="this.form.submit()">
                    <option value="">Todas</option>
                </select>
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">Nenhuma raça cadastrada@(especieFiltrada.HasValue ? " para esta espécie" : "").</p>
            <a asp-action="Create" asp-route-especieId="@especieFiltrada" class="btn btn-agro">Cadastrar raça</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Raça</th>
                        <th>Espécie</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nome</td>
                        <td>@item.Especie?.Nome</td>
                        <td class="text-end acoes">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">Total: @Model.Count() raça(s)</p>
}
