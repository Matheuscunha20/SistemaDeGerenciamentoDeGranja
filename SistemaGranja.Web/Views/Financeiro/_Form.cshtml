@model SistemaGranja.Domain.LancamentoFinanceiro

@{
    var categorias = ViewData["Categorias"] as List<CategoriaFinanceira> ?? new();
    var lotes = ViewData["Lotes"] as List<Lote> ?? new();
    var receita = Model.Tipo == TipoLancamento.Receita;
}

<fieldset class="mb-3">
    <legend class="form-label fs-6">Tipo</legend>
    <div class="btn-group w-100" role="group">
        <input type="radio" class="btn-check" name="Tipo" id="tipoReceita" value="Receita" autocomplete="off" checked="@receita" data-tipo-lancamento />
        <label class="btn btn-outline-success" for="tipoReceita">Receita (entrou dinheiro)</label>
        <input type="radio" class="btn-check" name="Tipo" id="tipoDespesa" value="Despesa" autocomplete="off" checked="@(!receita)" data-tipo-lancamento />
        <label class="btn btn-outline-danger" for="tipoDespesa">Despesa (saiu dinheiro)</label>
    </div>
</fieldset>

<div class="mb-3">
    <label asp-for="Descricao" class="form-label"></label>
    <input asp-for="Descricao" class="form-control" placeholder="Ex.: Compra de ração, Venda de 5 bezerros" />
    <span asp-validation-for="Descricao" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-sm-6">
        <div class="mb-3">
            <label asp-for="Valor" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">R$</span>
                <input asp-for="Valor" class="form-control" inputmode="decimal" value="@(Model.Valor > 0 ? Model.Valor.ToString("0.00") : "")" placeholder="0,00" />
            </div>
            <span asp-validation-for="Valor" class="text-danger"></span>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="mb-3">
            <label asp-for="Data" class="form-label" data-rotulo-data>@(Model.Pago ? "Data" : "Vencimento")</label>
            <input asp-for="Data" class="form-control" data-campo-data />
            <span asp-validation-for="Data" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row align-items-end">
    <div class="col-sm-6">
        <div class="form-check form-switch mb-3">
            <input asp-for="Pago" class="form-check-input" role="switch" data-campo-pago />
            <label asp-for="Pago" class="form-check-label" data-rotulo-pago>@(Model.Tipo == TipoLancamento.Receita ? "Já foi recebido" : "Já foi pago")</label>
            <div class="form-text">Desligue para lançar uma conta a @(Model.Tipo == TipoLancamento.Receita ? "receber" : "pagar") (em aberto).</div>
        </div>
    </div>
    <div class="col-sm-6" data-grupo-pagamento>
        <div class="mb-3">
            <label asp-for="DataPagamento" class="form-label"></label>
            <input asp-for="DataPagamento" class="form-control" data-campo-data-pagamento />
            <div class="form-text">Se ficar vazio, usa a mesma data acima.</div>
        </div>
    </div>
</div>

@if (Model.Id == 0)
{
    var repetir = ViewData["RepetirMeses"] as int? ?? 1;
    <div class="mb-3">
        <label class="form-label" for="repetirMeses">Repetir todo mês</label>
        <select class="form-select" id="repetirMeses" name="repetirMeses" style="max-width: 20rem">
            @for (var i = 1; i <= 36; i++)
            {
                var texto = i == 1 ? "Não repetir" : $"{i} vezes (parcelas mensais)";
                if (i == repetir)
                {
                    <option value="@i" selected>@texto</option>
                }
                else
                {
                    <option value="@i">@texto</option>
                }
            }
        </select>
        <div class="form-text">Ex.: um financiamento em 12 parcelas. As próximas ficam como contas em aberto, uma por mês.</div>
    </div>
}

<div class="row">
    <div class="col-sm-6">
        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label"></label>
            <select asp-for="CategoriaId" class="form-select" data-categorias>
                <option value="">-- Selecione --</option>
                @foreach (var c in categorias)
                {
                    if (c.Id == Model.CategoriaId)
                    {
                        <option value="@c.Id" data-tipo="@c.Tipo" selected>@c.Nome</option>
                    }
                    else
                    {
                        <option value="@c.Id" data-tipo="@c.Tipo">@c.Nome</option>
                    }
                }
            </select>
            <div class="form-text"><a asp-controller="CategoriasFinanceiras" asp-action="Index">Gerenciar categorias</a></div>
            <span asp-validation-for="CategoriaId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="mb-3">
            <label asp-for="FormaPagamento" class="form-label"></label>
            <select asp-for="FormaPagamento" class="form-select" asp-items="Html.GetEnumSelectList<FormaPagamento>()"></select>
            <span asp-validation-for="FormaPagamento" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="mb-3">
    <label asp-for="LoteId" class="form-label"></label>
    <select asp-for="LoteId" class="form-select">
        <option value="">Nenhum (despesa ou receita geral)</option>
        @foreach (var l in lotes)
        {
            if (l.Id == Model.LoteId)
            {
                <option value="@l.Id" selected>@l.CodigoLote</option>
            }
            else
            {
                <option value="@l.Id">@l.CodigoLote</option>
            }
        }
    </select>
    <div class="form-text">Ligue ao lote para depois ver o custo e o lucro de cada lote.</div>
</div>

<div class="mb-3">
    <label asp-for="Observacoes" class="form-label"></label>
    <textarea asp-for="Observacoes" class="form-control" rows="2" placeholder="Opcional"></textarea>
    <span asp-validation-for="Observacoes" class="text-danger"></span>
</div>
