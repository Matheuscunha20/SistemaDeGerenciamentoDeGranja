@model SistemaGranja.Domain.Funcionario

@{
    ViewData["Title"] = "Excluir";
    var registros = ViewData["QuantidadeRegistros"] as int? ?? 0;
}

<div class="page-header">
    <h1>Excluir funcionário</h1>
</div>

@if (registros > 0)
{
    <div class="alert alert-info">
        <strong>@Model.NomeCompleto</strong> tem @registros registro(s) no sistema (estoque, vacinação ou saúde)
        e não pode ser excluído. Use <strong>Desligar</strong> para manter o histórico.
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-agro">Ir para o cadastro</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
}
else
{
    <div class="alert alert-warning">
        Tem certeza que deseja excluir <strong>@Model.NomeCompleto</strong> (@Model.CpfFormatado)? Esta ação não pode ser desfeita.
        Se a pessoa apenas saiu da propriedade, prefira <strong>Desligar</strong>.
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Sim, excluir</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
}
