@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Criar nova senha";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        @if (Model.LinkInvalido)
        {
            <div class="text-center py-5">
                <h1 class="h3 mb-2">Link inválido</h1>
                <p class="text-muted">Este link de redefinição de senha não é válido. Peça um novo.</p>
                <a asp-page="./ForgotPassword" class="btn btn-agro">Pedir novo link</a>
            </div>
        }
        else
        {
            <div class="text-center mb-4">
                <h1 class="h2 fw-bold mb-1">Criar nova senha</h1>
            </div>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form method="post">
                        <input type="hidden" asp-for="Input.Codigo" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nome@exemplo.com" autofocus />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Senha" class="form-label"></label>
                            <input asp-for="Input.Senha" class="form-control" autocomplete="new-password" />
                            <div class="form-text">Pelo menos 6 caracteres, com letra maiúscula, letra minúscula, número e símbolo (ex.: Rebanho@2026).</div>
                            <span asp-validation-for="Input.Senha" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.ConfirmarSenha" class="form-label"></label>
                            <input asp-for="Input.ConfirmarSenha" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmarSenha" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-agro w-100">Salvar nova senha</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
