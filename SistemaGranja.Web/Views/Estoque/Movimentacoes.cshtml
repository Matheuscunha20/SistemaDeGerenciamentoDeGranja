@model IEnumerable<SistemaGranja.Domain.MovimentacaoEstoqueAlimento>
@using SistemaGranja.Domain

@{
    ViewData["Title"] = "Movimentações de estoque";
    var filtroAtivo = ViewData["FiltroAtivo"] is true;
    var tipoSelecionado = ViewData["Tipo"] as TipoMovimentacaoEstoque?;
}

<div class="page-header">
    <h1>Movimentações de estoque</h1>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-agro">+ Nova movimentação</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar ao estoque</a>
    </div>
</div>

<form asp-action="Movimentacoes" method="get" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="tipoAlimentoId" class="form-label small text-muted mb-1">Alimento</label>
                <select id="tipoAlimentoId" name="tipoAlimentoId" class="form-select" asp-items="ViewBag.FiltroAlimentos">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="tipo" class="form-label small text-muted mb-1">Tipo</label>
                <select id="tipo" name="tipo" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var t in Enum.GetValues<TipoMovimentacaoEstoque>())
                    {
                        if (t == tipoSelecionado)
                        {
                            <option value="@t" selected>@t.NomeExibicao()</option>
                        }
                        else
                        {
                            <option value="@t">@t.NomeExibicao()</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="de" class="form-label small text-muted mb-1">De</label>
                <input type="date" id="de" name="de" value="@ViewData["De"]" class="form-control" />
            </div>
            <div class="col-md-2">
                <label for="ate" class="form-label small text-muted mb-1">Até</label>
                <input type="date" id="ate" name="ate" value="@ViewData["Ate"]" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-agro flex-grow-1">Filtrar</button>
                @if (filtroAtivo)
                {
                    <a asp-action="Movimentacoes" class="btn btn-outline-secondary">Limpar</a>
                }
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">@(filtroAtivo ? "Nenhuma movimentação encontrada com esses filtros." : "Nenhuma movimentação registrada ainda.")</p>
            <a asp-action="Create" class="btn btn-agro">Registrar movimentação</a>
        </div>
    </div>
}
else
{
    var totalCompras = Model.Where(m => m.TipoMovimentacao == TipoMovimentacaoEstoque.EntradaCompra).Sum(m => m.ValorTotal);
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table tabela-cartoes table-hover mb-0">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Alimento</th>
                        <th class="text-end">Quantidade</th>
                        <th class="text-end">Valor</th>
                        <th>Fornecedor / destino</th>
                        <th>Registrado por</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var entrada = item.TipoMovimentacao.EhEntrada();
                    <tr>
                        <td class="fw-semibold">@item.DataMovimentacao.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge @item.TipoMovimentacao.CorExibicao()">@item.TipoMovimentacao.NomeExibicao()</span></td>
                        <td>@item.TipoAlimento?.Nome</td>
                        <td class="text-end @(entrada ? "text-success" : "text-danger")">@(entrada ? "+" : "−")@item.Quantidade.ToString("N2") @item.UnidadeMedida</td>
                        <td class="text-end">@(item.TipoMovimentacao == TipoMovimentacaoEstoque.EntradaCompra && item.PrecoUnitario > 0 ? item.ValorTotal.ToString("C2") : "—")</td>
                        <td>@(string.IsNullOrEmpty(item.FornecedorOuDestino) ? "—" : item.FornecedorOuDestino)</td>
                        <td>@(item.Funcionario?.NomeCompleto ?? "—")</td>
                        <td class="text-end acoes">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (User.PodeGerenciar()) { <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">@Model.Count() movimentação(ões) · compras no período: @totalCompras.ToString("C2")</p>
}
