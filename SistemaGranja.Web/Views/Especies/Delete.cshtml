@model SistemaGranja.Domain.Especie

@{
    ViewData["Title"] = "Excluir";
    var temRacas = Model.Racas.Any();
}

<div class="page-header">
    <h1>Excluir espécie</h1>
</div>

@if (temRacas)
{
    <div class="alert alert-info">
        A espécie <strong>@Model.Nome</strong> tem @Model.Racas.Count raça(s) cadastrada(s) e não pode ser excluída.
        Exclua as raças primeiro.
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Racas" asp-action="Index" asp-route-especieId="@Model.Id" class="btn btn-agro">Ver raças</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
}
else
{
    <div class="alert alert-warning">
        Tem certeza que deseja excluir a espécie <strong>@Model.Nome</strong>? Esta ação não pode ser desfeita.
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Sim, excluir</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
}
