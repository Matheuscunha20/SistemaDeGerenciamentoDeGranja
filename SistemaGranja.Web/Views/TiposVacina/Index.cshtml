@model IEnumerable<SistemaGranja.Domain.TipoVacina>

@{
    ViewData["Title"] = "Vacinas";
    var aplicacoes = ViewData["Aplicacoes"] as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="page-header">
    <h1>Vacinas cadastradas</h1>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-agro">+ Nova vacina</a>
        <a asp-controller="Vacinacoes" asp-action="Index" class="btn btn-outline-secondary">Ir para a agenda</a>
    </div>
</div>

<div class="alert alert-light border small">
    As vacinas e intervalos que vêm cadastrados são <strong>sugestões iniciais</strong>.
    Ajuste conforme a bula do produto e a orientação do médico-veterinário da propriedade.
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">Nenhuma vacina cadastrada.</p>
            <a asp-action="Create" class="btn btn-agro">Cadastrar vacina</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.NomeVacina)</th>
                        <th>@Html.DisplayNameFor(model => model.DoencaAlvo)</th>
                        <th>@Html.DisplayNameFor(model => model.ViaAdministracaoComum)</th>
                        <th>Reforço</th>
                        <th>Aplicações</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.NomeVacina</td>
                        <td class="small">@item.DoencaAlvo</td>
                        <td>@(string.IsNullOrEmpty(item.ViaAdministracaoComum) ? "—" : item.ViaAdministracaoComum)</td>
                        <td>@(item.IntervaloReforcoDias.HasValue ? $"a cada {item.IntervaloReforcoDias} dias" : "Dose única / protocolo")</td>
                        <td>@aplicacoes.GetValueOrDefault(item.Id)</td>
                        <td class="text-end acoes">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
