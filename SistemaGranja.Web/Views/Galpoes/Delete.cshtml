@model SistemaGranja.Domain.Galpao

@{
    ViewData["Title"] = "Excluir";
}

<div class="page-header">
    <h1>Excluir galpão</h1>
</div>

<div class="alert alert-warning">
    Tem certeza que deseja excluir este galpão? Esta ação não pode ser desfeita.
</div>

<div class="card shadow-sm form-card">
    <div class="card-body">
        <dl class="row detalhes">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NomeOuNumero)</dt>
            <dd class="col-sm-8">@Model.NomeOuNumero</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TipoInstalacao)</dt>
            <dd class="col-sm-8">@Model.TipoInstalacao</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CapacidadeMaxima)</dt>
            <dd class="col-sm-8">@Model.CapacidadeMaxima animais</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.LocalizacaoDescricao)</dt>
            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.LocalizacaoDescricao) ? "—" : Model.LocalizacaoDescricao)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Observacoes)</dt>
            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Observacoes) ? "—" : Model.Observacoes)</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Sim, excluir</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
