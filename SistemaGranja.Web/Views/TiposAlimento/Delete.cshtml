@model SistemaGranja.Domain.TipoAlimento

@{
    ViewData["Title"] = "Excluir";
}

<div class="page-header">
    <h1>Excluir tipo de alimento</h1>
</div>

<div class="alert alert-warning">
    Tem certeza que deseja excluir este tipo de alimento? Esta ação não pode ser desfeita.
</div>

<div class="card shadow-sm form-card">
    <div class="card-body">
        <dl class="row detalhes">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nome)</dt>
            <dd class="col-sm-8">@Model.Nome</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.UnidadeMedidaPadrao)</dt>
            <dd class="col-sm-8">@Model.UnidadeMedidaPadrao</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Fabricante)</dt>
            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Fabricante) ? "—" : Model.Fabricante)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CodigoInterno)</dt>
            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.CodigoInterno) ? "—" : Model.CodigoInterno)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Descricao)</dt>
            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Descricao) ? "—" : Model.Descricao)</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Sim, excluir</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
