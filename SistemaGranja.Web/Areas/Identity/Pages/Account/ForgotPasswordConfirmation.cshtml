@page
@model ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Verifique seu e-mail";
}

<div class="text-center py-5">
    <h1 class="h3 mb-2">Verifique seu e-mail</h1>
    <p class="text-muted">Se existir uma conta com esse e-mail, você vai receber um link para criar uma nova senha.<br />Confira também a caixa de spam.</p>
    <a asp-page="./Login" class="btn btn-agro">Voltar para o login</a>
</div>
