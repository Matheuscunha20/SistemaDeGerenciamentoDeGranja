@model SistemaGranja.Domain.Lote

<div class="row">
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="CodigoLote" class="form-label"></label>
            <input asp-for="CodigoLote" class="form-control text-uppercase" placeholder="Ex.: BEZERRAS-MAIO" />
            <span asp-validation-for="CodigoLote" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="DataCriacao" class="form-label"></label>
            <input asp-for="DataCriacao" class="form-control" />
            <span asp-validation-for="DataCriacao" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Descricao" class="form-label"></label>
    <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Ex.: Bezerras desmamadas para recria"></textarea>
    <span asp-validation-for="Descricao" class="text-danger"></span>
</div>
