@model SistemaGranja.Domain.Galpao

@{
    ViewData["Title"] = "Excluir";
    var ocupados = ViewData["Ocupados"] as int? ?? 0;
}

<div class="page-header">
    <h1>Excluir galpão</h1>
</div>

@if (ocupados > 0)
{
    <div class="alert alert-info">
        O galpão <strong>@Model.NomeOuNumero</strong> tem @ocupados animal(is) e não pode ser excluído.
        Mova os animais para outro galpão primeiro.
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-agro">Ver animais do galpão</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
}
else
{
    <div class="alert alert-warning">
        Tem certeza que deseja excluir o galpão <strong>@Model.NomeOuNumero</strong>? Esta ação não pode ser desfeita.
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Sim, excluir</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
}
