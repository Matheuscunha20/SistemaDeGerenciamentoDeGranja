@{
    ViewData["Title"] = "Início";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">AgroArca</h1>
    <p class="lead text-muted mb-4">Cuide do seu rebanho como um bom pastor.</p>
    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-agro btn-lg me-2">Entrar</a>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-secondary btn-lg">Criar conta</a>
</div>

<div class="row g-4 pb-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Rebanho organizado</h2>
            <p class="text-muted mb-0">Animais de qualquer espécie, com raça, idade, galpão e lote. Busca e filtros para achar qualquer um em segundos.</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Sanidade em dia</h2>
            <p class="text-muted mb-0">Agenda de vacinas com doses atrasadas, vacinação em grupo e histórico de saúde de cada animal.</p>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Estoque sob controle</h2>
            <p class="text-muted mb-0">Entradas e saídas de alimento, aviso de estoque baixo e previsão de quantos dias o estoque dura.</p>
        </div></div>
    </div>
</div>
