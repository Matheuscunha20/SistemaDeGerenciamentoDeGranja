@model IEnumerable<SistemaGranja.Domain.RegistroVacinacao>

@{
    ViewData["Title"] = "Agenda de vacinação";
    var dias = ViewData["Dias"] as int? ?? 30;
    var hoje = DateTime.Today;
    var atrasadas = Model.Count(r => r.DataProximaDoseRecomendada!.Value.Date < hoje);
    var proximas = Model.Count() - atrasadas;
}

<partial name="_Abas" />

<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2">
        <span class="badge bg-danger fs-6 fw-normal">@atrasadas atrasada(s)</span>
        <span class="badge bg-warning text-dark fs-6 fw-normal">@proximas nos próximos @dias dias</span>
    </div>
    <div class="btn-group" role="group" aria-label="Período">
        @foreach (var opcao in new[] { 7, 30, 90 })
        {
            <a asp-action="Index" asp-route-dias="@opcao" class="btn btn-sm @(opcao == dias ? "btn-agro" : "btn-outline-secondary")">@opcao dias</a>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-1">Nenhuma dose atrasada ou prevista para os próximos @dias dias.</p>
            <p class="small mb-0">As doses aparecem aqui quando uma vacinação é registrada com "Próxima dose".</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table tabela-cartoes table-hover mb-0">
                <thead>
                    <tr>
                        <th>Próxima dose</th>
                        <th>Situação</th>
                        <th>Animal</th>
                        <th>Espécie</th>
                        <th>Galpão</th>
                        <th>Vacina</th>
                        <th>Última aplicação</th>
                        <th class="text-end">Ação</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var data = item.DataProximaDoseRecomendada!.Value.Date;
                    var diferenca = (data - hoje).Days;
                    <tr class="@(diferenca < 0 ? "table-danger" : "")">
                        <td class="fw-semibold">@data.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (diferenca < 0)
                            {
                                <span class="badge bg-danger">Atrasada há @(-diferenca) dia(s)</span>
                            }
                            else if (diferenca == 0)
                            {
                                <span class="badge bg-warning text-dark">Hoje</span>
                            }
                            else
                            {
                                <span class="badge bg-body-secondary text-body border">Em @diferenca dia(s)</span>
                            }
                        </td>
                        <td><a asp-controller="Animais" asp-action="Details" asp-route-id="@item.AnimalId">@item.Animal?.TagIdentificacao</a></td>
                        <td>@(item.Animal?.Raca?.Especie?.Nome ?? "—")</td>
                        <td>@(item.Animal?.Galpao?.NomeOuNumero ?? "—")</td>
                        <td>@item.TipoVacina?.NomeVacina</td>
                        <td>@item.DataVacinacao.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Create" asp-route-animalId="@item.AnimalId" asp-route-tipoVacinaId="@item.TipoVacinaId"
                               class="btn btn-sm btn-agro">Aplicar dose</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
