@model SistemaGranja.Domain.Animal

@{
    ViewData["Title"] = "Detalhes";
}
@functions {
    string CorStatus(string status) => status switch
    {
        "Saudável" => "bg-success",
        "Em observação" => "bg-info text-dark",
        "Em tratamento" => "bg-warning text-dark",
        "Em quarentena" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="page-header">
    <h1>@Model.TagIdentificacao</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-agro">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar para a lista</a>
    </div>
</div>

<div class="card shadow-sm form-card">
    <div class="card-body">
        <dl class="row detalhes mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TagIdentificacao)</dt>
            <dd class="col-sm-8">@Model.TagIdentificacao</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nome)</dt>
            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Nome) ? "—" : Model.Nome)</dd>
            <dt class="col-sm-4">Espécie</dt>
            <dd class="col-sm-8">@(Model.Raca?.Especie?.Nome ?? "—")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Raca)</dt>
            <dd class="col-sm-8">@(Model.Raca?.Nome ?? "—")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DataNascimento)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.DataNascimento) <span class="text-muted">(@Model.IdadeDescricao)</span></dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Sexo)</dt>
            <dd class="col-sm-8">@Model.Sexo</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PesoAtual)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.PesoAtual) kg</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.StatusSaude)</dt>
            <dd class="col-sm-8"><span class="badge @CorStatus(Model.StatusSaude)">@Model.StatusSaude</span></dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Galpao)</dt>
            <dd class="col-sm-8">@(Model.Galpao?.NomeOuNumero ?? "—")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Lote)</dt>
            <dd class="col-sm-8">@(Model.Lote?.CodigoLote ?? "—")</dd>
        </dl>
    </div>
</div>

@{
    var vacinacoes = ViewData["Vacinacoes"] as List<SistemaGranja.Domain.RegistroVacinacao> ?? new List<SistemaGranja.Domain.RegistroVacinacao>();
}

<div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Vacinação</span>
        <a asp-controller="Vacinacoes" asp-action="Create" asp-route-animalId="@Model.Id" class="btn btn-sm btn-agro">+ Registrar vacina</a>
    </div>
    @if (vacinacoes.Count == 0)
    {
        <div class="lista-vazia">Nenhuma vacina registrada para este animal.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table tabela-cartoes table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Vacina</th>
                        <th>Dose</th>
                        <th>Aplicado por</th>
                        <th>Próxima dose</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var v in vacinacoes)
                {
                    var atrasada = v.DataProximaDoseRecomendada.HasValue && v.DataProximaDoseRecomendada.Value.Date < DateTime.Today;
                    <tr>
                        <td>@v.DataVacinacao.ToString("dd/MM/yyyy")</td>
                        <td>@v.TipoVacina?.NomeVacina</td>
                        <td>@(string.IsNullOrEmpty(v.DoseAplicada) ? "—" : v.DoseAplicada)</td>
                        <td>@(v.Funcionario?.NomeCompleto ?? "—")</td>
                        <td class="@(atrasada ? "text-danger fw-semibold" : "")">@(v.DataProximaDoseRecomendada?.ToString("dd/MM/yyyy") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@{
    var ocorrencias = ViewData["OcorrenciasSaude"] as List<SistemaGranja.Domain.RegistroSaude> ?? new List<SistemaGranja.Domain.RegistroSaude>();
}

<div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Saúde</span>
        <a asp-controller="Saude" asp-action="Create" asp-route-animalId="@Model.Id" class="btn btn-sm btn-agro">+ Registrar ocorrência</a>
    </div>
    @if (ocorrencias.Count == 0)
    {
        <div class="lista-vazia">Nenhuma ocorrência de saúde registrada para este animal.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table tabela-cartoes table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>O que aconteceu</th>
                        <th>Diagnóstico</th>
                        <th>Atendido por</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var o in ocorrencias)
                {
                    <tr>
                        <td>@o.DataOcorrencia.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge @SistemaGranja.Domain.TipoOcorrenciaSaudeExtensions.CorExibicao(o.TipoOcorrencia)">@SistemaGranja.Domain.TipoOcorrenciaSaudeExtensions.NomeExibicao(o.TipoOcorrencia)</span></td>
                        <td class="small text-truncate" style="max-width: 260px;" title="@o.DescricaoDetalhada">@o.DescricaoDetalhada</td>
                        <td>@(string.IsNullOrEmpty(o.Diagnostico) ? "—" : o.Diagnostico)</td>
                        <td>@(o.Funcionario?.NomeCompleto ?? "—")</td>
                        <td class="text-end"><a asp-controller="Saude" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Ver</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
