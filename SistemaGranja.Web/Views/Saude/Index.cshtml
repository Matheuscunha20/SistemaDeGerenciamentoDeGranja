@model IEnumerable<SistemaGranja.Domain.RegistroSaude>
@using SistemaGranja.Domain

@{
    ViewData["Title"] = "Saúde";
    var filtroAtivo = ViewData["FiltroAtivo"] is true;
    var porEstado = ViewData["AnimaisPorEstado"] as Dictionary<string, int> ?? new Dictionary<string, int>();
    var tipoSelecionado = ViewData["Tipo"] as TipoOcorrenciaSaude?;
    var cartoes = new[]
    {
        ("Em tratamento", "destaque-warning"),
        ("Em quarentena", "destaque-danger"),
        ("Em observação", "destaque-info"),
        ("Saudável", "destaque-success")
    };
}

<div class="page-header">
    <h1>Saúde</h1>
    <a asp-action="Create" class="btn btn-agro">+ Registrar ocorrência</a>
</div>

<div class="row g-3 mb-4">
    @foreach (var (estado, borda) in cartoes)
    {
        <div class="col-sm-6 col-lg-3">
            <a asp-controller="Animais" asp-action="Index" asp-route-statusSaude="@estado" class="text-decoration-none text-reset">
                <div class="card shadow-sm h-100 card-destaque @borda">
                    <div class="card-body">
                        <div class="small text-muted">@estado</div>
                        <div class="fs-4 fw-semibold">@porEstado.GetValueOrDefault(estado)</div>
                        <div class="small text-muted">animal(is) · ver lista</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<form asp-action="Index" method="get" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="busca" class="form-label small text-muted mb-1">Buscar</label>
                <input type="search" id="busca" name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Animal, diagnóstico..." />
            </div>
            <div class="col-md-3">
                <label for="tipo" class="form-label small text-muted mb-1">Tipo</label>
                <select id="tipo" name="tipo" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var t in Enum.GetValues<TipoOcorrenciaSaude>())
                    {
                        if (t == tipoSelecionado)
                        {
                            <option value="@t" selected>@t.NomeExibicao()</option>
                        }
                        else
                        {
                            <option value="@t">@t.NomeExibicao()</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="de" class="form-label small text-muted mb-1">De</label>
                <input type="date" id="de" name="de" value="@ViewData["De"]" class="form-control" />
            </div>
            <div class="col-md-2">
                <label for="ate" class="form-label small text-muted mb-1">Até</label>
                <input type="date" id="ate" name="ate" value="@ViewData["Ate"]" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-agro flex-grow-1">Filtrar</button>
                @if (filtroAtivo)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
                }
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">@(filtroAtivo ? "Nenhuma ocorrência encontrada com esses filtros." : "Nenhuma ocorrência de saúde registrada ainda.")</p>
            <a asp-action="Create" class="btn btn-agro">Registrar ocorrência</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Animal</th>
                        <th>Tipo</th>
                        <th>O que aconteceu</th>
                        <th>Diagnóstico</th>
                        <th>Atendido por</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.DataOcorrencia.ToString("dd/MM/yyyy")</td>
                        <td><a asp-controller="Animais" asp-action="Details" asp-route-id="@item.AnimalId">@item.Animal?.TagIdentificacao</a></td>
                        <td><span class="badge @item.TipoOcorrencia.CorExibicao()">@item.TipoOcorrencia.NomeExibicao()</span></td>
                        <td class="small text-truncate" style="max-width: 280px;" title="@item.DescricaoDetalhada">@item.DescricaoDetalhada</td>
                        <td>@(string.IsNullOrEmpty(item.Diagnostico) ? "—" : item.Diagnostico)</td>
                        <td>@(item.Funcionario?.NomeCompleto ?? "—")</td>
                        <td class="text-end acoes">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">@Model.Count() ocorrência(s)</p>
}
