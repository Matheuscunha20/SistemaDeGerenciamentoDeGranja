@using Microsoft.AspNetCore.Identity
@using SistemaGranja.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Minha conta">
                <span class="d-inline-block align-middle">
                    <span class="d-block small opacity-75 lh-1">@User.FindFirst(FazendaDoUsuarioLogado.ClaimFazendaNome)?.Value</span>
                    @UserManager.GetUserName(User)
                </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><span class="dropdown-item-text small text-muted">Perfil: @User.NomeDoPerfil()</span></li>
                <li><hr class="dropdown-divider" /></li>
                @if (User.EhDono())
                {
                    <li><a class="dropdown-item" asp-area="" asp-controller="Equipe" asp-action="Index">Equipe</a></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="Fazenda" asp-action="Index">Dados da fazenda</a></li>
                }
                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Minha conta</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="dropdown-item">Sair</button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register">Registrar</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
        </li>
    }
</ul>
