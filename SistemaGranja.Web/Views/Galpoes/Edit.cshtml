@model SistemaGranja.Domain.Galpao

@{
    ViewData["Title"] = "Editar galpão";
}

<div class="page-header">
    <h1>Editar galpão</h1>
</div>

<div class="card shadow-sm form-card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />
            @if (ViewData["Ocupados"] is int ocupados && ocupados > 0)
            {
                <div class="alert alert-light border small">
                    Este galpão tem <strong>@ocupados animal(is)</strong>. A capacidade não pode ficar abaixo disso.
                </div>
            }
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-agro">Salvar alterações</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
