# Copie este arquivo para ".env" e troque as senhas.
# O arquivo .env NÃO vai para o GitHub.

# Banco local de desenvolvimento (docker-compose.yml) e banco do servidor (docker-compose.producao.yml)
MYSQL_ROOT_PASSWORD=troque_esta_senha

# Só para docker-compose.producao.yml: senha do usuário "agroarca" do banco
MYSQL_PASSWORD=troque_esta_senha_tambem

# Só para docker-compose.producao.yml: e-mail (opcional; sem isso os e-mails não são enviados)
EMAIL_SERVIDOR=
EMAIL_PORTA=587
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_REMETENTE=

# true quando o sistema estiver atrás de um proxy que cuida do HTTPS (Caddy, Nginx, plataforma)
CONFIAR_NO_PROXY=false
