@model IEnumerable<SistemaGranja.Domain.Lote>

@{
    ViewData["Title"] = "Lotes";
    var situacao = ViewData["Situacao"] as string ?? "ativos";
    var quantidades = ViewData["QuantidadeAnimais"] as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="page-header">
    <h1>Lotes</h1>
    @if (User.PodeGerenciar()) { <a asp-action="Create" class="btn btn-agro">+ Novo lote</a> }
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(situacao == "ativos" ? "active" : "")" asp-action="Index" asp-route-situacao="ativos">Ativos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(situacao == "encerrados" ? "active" : "")" asp-action="Index" asp-route-situacao="encerrados">Encerrados</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(situacao == "todos" ? "active" : "")" asp-action="Index" asp-route-situacao="todos">Todos</a>
    </li>
</ul>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="lista-vazia">
            <p class="mb-3">Nenhum lote @(situacao == "encerrados" ? "encerrado" : situacao == "ativos" ? "ativo" : "cadastrado").</p>
            @if (User.PodeGerenciar()) { <a asp-action="Create" class="btn btn-agro">Criar lote</a> }
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table tabela-cartoes table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.CodigoLote)</th>
                        <th>@Html.DisplayNameFor(model => model.Descricao)</th>
                        <th>@Html.DisplayNameFor(model => model.DataCriacao)</th>
                        <th>Animais</th>
                        <th>@Html.DisplayNameFor(model => model.Ativo)</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.CodigoLote</td>
                        <td>@(string.IsNullOrEmpty(item.Descricao) ? "—" : item.Descricao)</td>
                        <td>@Html.DisplayFor(m => item.DataCriacao)</td>
                        <td>@quantidades.GetValueOrDefault(item.Id)</td>
                        <td>
                            @if (item.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Encerrado</span>
                            }
                        </td>
                        <td class="text-end acoes">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            @if (User.PodeGerenciar()) { <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a> }
                            @if (User.PodeGerenciar()) { <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2 small">Total: @Model.Count() lote(s)</p>
}
