@model SistemaGranja.Domain.RegistroVacinacao
@*
    Campos da aplicação (vacina, data, dose, frasco, responsável, próxima dose).
    Usado no registro individual e na vacinação em grupo.
*@
@{
    var vacinas = ViewData["Vacinas"] as List<SistemaGranja.Domain.TipoVacina> ?? new List<SistemaGranja.Domain.TipoVacina>();
}

<div class="row">
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="TipoVacinaId" class="form-label"></label>
            <select asp-for="TipoVacinaId" class="form-select">
                <option value="0">-- Selecione --</option>
                @foreach (var vacina in vacinas)
                {
                    <option value="@vacina.Id" data-intervalo="@vacina.IntervaloReforcoDias" data-dose="@vacina.DosagemPadraoRecomendada">@vacina.NomeVacina</option>
                }
            </select>
            <span asp-validation-for="TipoVacinaId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="DataVacinacao" class="form-label"></label>
            <input asp-for="DataVacinacao" class="form-control" />
            <span asp-validation-for="DataVacinacao" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="DoseAplicada" class="form-label"></label>
            <input asp-for="DoseAplicada" class="form-control" placeholder="Ex.: 2 ml" />
            <span asp-validation-for="DoseAplicada" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="LoteProdutoVacina" class="form-label"></label>
            <input asp-for="LoteProdutoVacina" class="form-control" placeholder="Opcional" />
            <span asp-validation-for="LoteProdutoVacina" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="ValidadeProdutoVacina" class="form-label"></label>
            <input asp-for="ValidadeProdutoVacina" class="form-control" />
            <span asp-validation-for="ValidadeProdutoVacina" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="FuncionarioId" class="form-label"></label>
            <select asp-for="FuncionarioId" class="form-select" asp-items="ViewBag.Funcionarios">
                <option value="">-- Não informado --</option>
            </select>
            <span asp-validation-for="FuncionarioId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <label asp-for="DataProximaDoseRecomendada" class="form-label"></label>
            <input asp-for="DataProximaDoseRecomendada" class="form-control" />
            <div class="form-text" id="dicaProximaDose">Preenchida pelo intervalo da vacina. Deixe vazio se for dose única.</div>
            <span asp-validation-for="DataProximaDoseRecomendada" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Observacoes" class="form-label"></label>
    <textarea asp-for="Observacoes" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Observacoes" class="text-danger"></span>
</div>
