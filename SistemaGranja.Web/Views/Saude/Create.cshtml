@model SistemaGranja.Domain.RegistroSaude

@{
    ViewData["Title"] = "Registrar ocorrência de saúde";
    var novoEstado = ViewData["NovoEstado"] as string;
}

<div class="page-header">
    <h1>Registrar ocorrência de saúde</h1>
</div>

<div class="card shadow-sm" style="max-width: 820px;">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" name="voltarParaAnimal" value="@ViewData["VoltarParaAnimal"]" />
            <partial name="_Form" model="Model" />

            <div class="mb-3 p-3 bg-body-tertiary border rounded">
                <label for="novoEstadoDoAnimal" class="form-label fw-semibold">Atualizar o estado de saúde do animal?</label>
                <select id="novoEstadoDoAnimal" name="novoEstadoDoAnimal" class="form-select">
                    <option value="">Manter como está</option>
                    @foreach (var estado in AnimaisController.EstadosDeSaude)
                    {
                        if (estado == novoEstado)
                        {
                            <option value="@estado" selected>@estado</option>
                        }
                        else
                        {
                            <option value="@estado">@estado</option>
                        }
                    }
                </select>
                <div class="form-text" id="dicaEstado">Ex.: ao diagnosticar uma doença, marque o animal como "Em tratamento".</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-agro">Registrar</button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Sugere o novo estado do animal conforme o tipo de ocorrência
        (function () {
            var tipo = document.getElementById('TipoOcorrencia');
            var estado = document.getElementById('novoEstadoDoAnimal');
            if (!tipo || !estado) return;

            var sugestoes = {
                '1': 'Em tratamento', // Doença diagnosticada
                '2': 'Em observação', // Ferimento
                '3': 'Em tratamento', // Início de tratamento
                '4': 'Saudável'       // Fim de tratamento
            };
            var usuarioEscolheu = estado.value !== '';

            estado.addEventListener('change', function () { usuarioEscolheu = true; });
            tipo.addEventListener('change', function () {
                if (usuarioEscolheu) return;
                estado.value = sugestoes[tipo.value] || '';
            });
        })();
    </script>
}
