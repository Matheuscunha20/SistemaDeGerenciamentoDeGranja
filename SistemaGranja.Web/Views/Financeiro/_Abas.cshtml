@* Abas do financeiro *@
@{
    var acao = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Ativa(string a, string c = "Financeiro") => acao == a && controller == c ? "active" : "";
}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @Ativa("Index")" asp-controller="Financeiro" asp-action="Index">Lançamentos</a></li>
    <li class="nav-item"><a class="nav-link @Ativa("Contas")" asp-controller="Financeiro" asp-action="Contas">Contas a pagar e receber</a></li>
    <li class="nav-item"><a class="nav-link @Ativa("FluxoDeCaixa")" asp-controller="Financeiro" asp-action="FluxoDeCaixa">Fluxo de caixa</a></li>
    <li class="nav-item"><a class="nav-link @Ativa("Index", "CategoriasFinanceiras")" asp-controller="CategoriasFinanceiras" asp-action="Index">Categorias</a></li>
</ul>
