@{
    ViewData["Title"] = "Início";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Granja Sol</h1>
    <p class="lead text-muted">Sistema de gerenciamento de animais, galpões e alimentação.</p>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Animais</h5>
                    <p class="card-text text-muted">Cadastre e acompanhe os animais da granja.</p>
                    <a asp-controller="Animais" asp-action="Index" class="btn btn-granja">Abrir</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Galpões</h5>
                    <p class="card-text text-muted">Gerencie os galpões e suas capacidades.</p>
                    <a asp-controller="Galpoes" asp-action="Index" class="btn btn-granja">Abrir</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Tipos de Alimento</h5>
                    <p class="card-text text-muted">Mantenha o cadastro de rações e alimentos.</p>
                    <a asp-controller="TiposAlimento" asp-action="Index" class="btn btn-granja">Abrir</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center">
        <p>Entre com sua conta para acessar o sistema.</p>
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-granja btn-lg me-2">Entrar</a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-secondary btn-lg">Criar conta</a>
    </div>
}
